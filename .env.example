DATABASE_URL="postgres://abundant:abundant@localhost:5432/abundant_harbor"

# Live mode (required): at least one non-empty key. Restart `npm run dev` after edits.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Harbor CLI for sweeps and publish validation.
HARBOR_BIN="harbor"

# Registry publish (default). Run `harbor auth login` locally.
HARBOR_PUBLISH_ORG="your-harbor-org"

# Optional GitHub export owner (used when PUBLISH_TARGET includes github).
HARBOR_PUBLISH_OWNER=""

# registry | github | both
PUBLISH_TARGET="registry"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
