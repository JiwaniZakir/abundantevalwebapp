DATABASE_URL="postgres://abundant:abundant@localhost:5432/abundant_harbor"
# At least one of these enables Live mode in the agent runtime.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Used by the run_harbor_sweep tool and the Publish connector validation step.
HARBOR_BIN="harbor"

# Publish connector. Requires `gh` CLI authenticated locally.
# Repos are created under your authenticated gh account by default.
HARBOR_PUBLISH_OWNER=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
