DATABASE_URL="postgres://abundant:abundant@localhost:5432/abundant_harbor"

# Live mode: at least one of these enables real LLM orchestration.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Used by the run_harbor_sweep tool and Publish connector validation.
# Set to a full path if `harbor` isn't on PATH.
HARBOR_BIN="harbor"

# Publish connector. Requires `gh` CLI authenticated locally.
# Leave blank to publish under your authenticated gh user; otherwise prepends owner/.
HARBOR_PUBLISH_OWNER=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
